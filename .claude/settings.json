{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/sonar-secrets/build-scripts/pretool-secrets.ps1\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/sonar-secrets/build-scripts/prompt-secrets.ps1\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/sonar-sqaa/build-scripts/posttool-sqaa.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true
  }
}
